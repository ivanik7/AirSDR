+/**
+ * Open a HackRF device from a file descriptor already owned by the caller
+ * (e.g. an Android UsbDeviceConnection fd). Requires libusb built with
+ * libusb_wrap_sys_device() support (1.0.23+) and, on Android,
+ * LIBUSB_OPTION_NO_DEVICE_DISCOVERY set via @ref hackrf_init.
+ * libusb_wrap_sys_device() duplicates the fd internally; the caller retains
+ * ownership of the fd it passed in.
+ *
+ * @param fd File descriptor of an already-opened USB device, owned by the caller
+ * @param device output device, after done with device call @ref hackrf_close
+ * @return @ref HACKRF_SUCCESS on success, @ref HACKRF_ERROR_INVALID_PARAM if @p fd is negative or @p device is NULL, @ref HACKRF_ERROR_NOT_FOUND if the fd cannot be wrapped, @ref HACKRF_ERROR_UNSUPPORTED on platforms without this API
+ * @ingroup device
+ */
+extern ADDAPI int ADDCALL hackrf_open_by_fd(int fd, hackrf_device** device);
