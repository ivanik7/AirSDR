<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 10+: do not let the platform add a pale 3-button contrast scrim
         over the dark Flutter canvas (Android 15 enforces edge-to-edge). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/airsdr_background</item>
        <item name="android:navigationBarColor">@color/airsdr_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/airsdr_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
